digraph UML {
  graph [label="Bairro Ativo - Diagrama de classes (domínio / model)", labelloc=t, fontsize=22, fontname="Helvetica", rankdir=TB, nodesep=0.35, ranksep=0.7, newrank=true];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  subgraph "cluster_model" {
    label="pacote model"; style="rounded,dashed"; color="#9aa5a0"; fontsize=13;
    "Apoio" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e3f1ec"><b>Apoio</b></td></tr><hr/><tr><td align="left" balign="left">- cidadao : Cidadao<br align="left"/>- idOcorrencia : Long<br align="left"/>- data : LocalDateTime<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ Apoio()<br align="left"/>+ Apoio(cidadao : Cidadao, idOcorrencia : Long, data : LocalDateTime)<br align="left"/>+ getCidadao() : Cidadao<br align="left"/>+ getData() : LocalDateTime<br align="left"/>+ getIdOcorrencia() : Long<br align="left"/>+ setCidadao(cidadao : Cidadao) : void<br align="left"/>+ setData(data : LocalDateTime) : void<br align="left"/>+ setIdOcorrencia(idOcorrencia : Long) : void<br align="left"/></td></tr></table>>];
    "Atualizacao" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e3f1ec"><b>Atualizacao</b></td></tr><hr/><tr><td align="left" balign="left">- id : Long<br align="left"/>- idOcorrencia : Long<br align="left"/>- servidor : ServidorPublico<br align="left"/>- statusAnterior : StatusOcorrencia<br align="left"/>- statusNovo : StatusOcorrencia<br align="left"/>- comentario : String<br align="left"/>- data : LocalDateTime<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ Atualizacao()<br align="left"/>+ getComentario() : String<br align="left"/>+ getData() : LocalDateTime<br align="left"/>+ getId() : Long<br align="left"/>+ getIdOcorrencia() : Long<br align="left"/>+ getServidor() : ServidorPublico<br align="left"/>+ getStatusAnterior() : StatusOcorrencia<br align="left"/>+ getStatusNovo() : StatusOcorrencia<br align="left"/>+ setComentario(comentario : String) : void<br align="left"/>+ setData(data : LocalDateTime) : void<br align="left"/>+ setId(id : Long) : void<br align="left"/>+ setIdOcorrencia(idOcorrencia : Long) : void<br align="left"/>+ setServidor(servidor : ServidorPublico) : void<br align="left"/>+ setStatusAnterior(statusAnterior : StatusOcorrencia) : void<br align="left"/>+ setStatusNovo(statusNovo : StatusOcorrencia) : void<br align="left"/></td></tr></table>>];
    "Bairro" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e3f1ec"><b>Bairro</b></td></tr><hr/><tr><td align="left" balign="left">- id : Long<br align="left"/>- nome : String<br align="left"/>- zona : Zona<br align="left"/>- cidade : String<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ Bairro()<br align="left"/>+ Bairro(id : Long, nome : String, zona : Zona, cidade : String)<br align="left"/>+ getCidade() : String<br align="left"/>+ getId() : Long<br align="left"/>+ getNome() : String<br align="left"/>+ getZona() : Zona<br align="left"/>+ setCidade(cidade : String) : void<br align="left"/>+ setId(id : Long) : void<br align="left"/>+ setNome(nome : String) : void<br align="left"/>+ setZona(zona : Zona) : void<br align="left"/></td></tr></table>>];
    "Categoria" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e3f1ec"><b>Categoria</b></td></tr><hr/><tr><td align="left" balign="left">- id : Long<br align="left"/>- nome : String<br align="left"/>- descricao : String<br align="left"/>- prazoDias : int<br align="left"/>- orgao : Orgao<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ Categoria()<br align="left"/>+ Categoria(id : Long, nome : String, descricao : String, prazoDias : int, orgao : Orgao)<br align="left"/>+ getDescricao() : String<br align="left"/>+ getId() : Long<br align="left"/>+ getNome() : String<br align="left"/>+ getOrgao() : Orgao<br align="left"/>+ getPrazoDias() : int<br align="left"/>+ setDescricao(descricao : String) : void<br align="left"/>+ setId(id : Long) : void<br align="left"/>+ setNome(nome : String) : void<br align="left"/>+ setOrgao(orgao : Orgao) : void<br align="left"/>+ setPrazoDias(prazoDias : int) : void<br align="left"/></td></tr></table>>];
    "Cidadao" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e3f1ec"><b>Cidadao</b></td></tr><hr/><tr><td align="left" balign="left">- bairro : Bairro<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ Cidadao()<br align="left"/>+ Cidadao(id : Long, nome : String, email : String, telefone : String, dataCadastro : LocalDateTime, bairro : Bairro)<br align="left"/>+ getBairro() : Bairro<br align="left"/>+ getDescricaoPerfil() : String<br align="left"/>+ getTipo() : TipoUsuario<br align="left"/>+ podeAtender(ocorrencia : Ocorrencia) : boolean<br align="left"/>+ podeEditar(ocorrencia : Ocorrencia) : boolean<br align="left"/>+ setBairro(bairro : Bairro) : void<br align="left"/></td></tr></table>>];
    "NivelPrioridade" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e3f1ec"><font point-size="9">«enumeration»</font><br/><b>NivelPrioridade</b></td></tr><hr/><tr><td align="left" balign="left">BAIXA<br align="left"/>MEDIA<br align="left"/>ALTA<br align="left"/><u>+ MINIMO_MEDIA : int</u><br align="left"/><u>+ MINIMO_ALTA : int</u><br align="left"/></td></tr><hr/><tr><td align="left" balign="left"><u>+ de(pontuacao : int) : NivelPrioridade</u><br align="left"/></td></tr></table>>];
    "Ocorrencia" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e3f1ec"><b>Ocorrencia</b></td></tr><hr/><tr><td align="left" balign="left"><u>+ PONTOS_POR_APOIO : int</u><br align="left"/><u>+ PONTOS_ATRASO : int</u><br align="left"/>- id : Long<br align="left"/>- titulo : String<br align="left"/>- descricao : String<br align="left"/>- endereco : String<br align="left"/>- referencia : String<br align="left"/>- bairro : Bairro<br align="left"/>- categoria : Categoria<br align="left"/>- autor : Cidadao<br align="left"/>- status : StatusOcorrencia<br align="left"/>- dataAbertura : LocalDateTime<br align="left"/>- dataResolucao : LocalDateTime<br align="left"/>- totalApoios : int<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ Ocorrencia()<br align="left"/>+ atrasada(agora : LocalDateTime) : boolean<br align="left"/>+ diasEmAberto(agora : LocalDateTime) : long<br align="left"/>+ getAutor() : Cidadao<br align="left"/>+ getBairro() : Bairro<br align="left"/>+ getCategoria() : Categoria<br align="left"/>+ getDataAbertura() : LocalDateTime<br align="left"/>+ getDataResolucao() : LocalDateTime<br align="left"/>+ getDescricao() : String<br align="left"/>+ getDiasEmAberto() : long<br align="left"/>+ getEndereco() : String<br align="left"/>+ getId() : Long<br align="left"/>+ getPontuacaoPrioridade() : int<br align="left"/>+ getReferencia() : String<br align="left"/>+ getStatus() : StatusOcorrencia<br align="left"/>+ getTitulo() : String<br align="left"/>+ getTotalApoios() : int<br align="left"/>+ isAtrasada() : boolean<br align="left"/>+ isPendente() : boolean<br align="left"/>+ pontuacao(agora : LocalDateTime) : int<br align="left"/>+ setAutor(autor : Cidadao) : void<br align="left"/>+ setBairro(bairro : Bairro) : void<br align="left"/>+ setCategoria(categoria : Categoria) : void<br align="left"/>+ setDataAbertura(dataAbertura : LocalDateTime) : void<br align="left"/>+ setDataResolucao(dataResolucao : LocalDateTime) : void<br align="left"/>+ setDescricao(descricao : String) : void<br align="left"/>+ setEndereco(endereco : String) : void<br align="left"/>+ setId(id : Long) : void<br align="left"/>+ setReferencia(referencia : String) : void<br align="left"/>+ setStatus(status : StatusOcorrencia) : void<br align="left"/>+ setTitulo(titulo : String) : void<br align="left"/>+ setTotalApoios(totalApoios : int) : void<br align="left"/></td></tr></table>>];
    "Orgao" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e3f1ec"><b>Orgao</b></td></tr><hr/><tr><td align="left" balign="left">- id : Long<br align="left"/>- nome : String<br align="left"/>- sigla : String<br align="left"/>- telefone : String<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ Orgao()<br align="left"/>+ Orgao(id : Long, nome : String, sigla : String, telefone : String)<br align="left"/>+ getId() : Long<br align="left"/>+ getNome() : String<br align="left"/>+ getSigla() : String<br align="left"/>+ getTelefone() : String<br align="left"/>+ setId(id : Long) : void<br align="left"/>+ setNome(nome : String) : void<br align="left"/>+ setSigla(sigla : String) : void<br align="left"/>+ setTelefone(telefone : String) : void<br align="left"/></td></tr></table>>];
    "Priorizavel" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e3f1ec"><font point-size="9">«interface»</font><br/><b>Priorizavel</b></td></tr><hr/><tr><td> </td></tr><hr/><tr><td align="left" balign="left">+ getNivelPrioridade() : NivelPrioridade<br align="left"/>+ getPontuacaoPrioridade() : int<br align="left"/></td></tr></table>>];
    "ServidorPublico" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e3f1ec"><b>ServidorPublico</b></td></tr><hr/><tr><td align="left" balign="left">- matricula : String<br align="left"/>- cargo : String<br align="left"/>- orgao : Orgao<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ ServidorPublico()<br align="left"/>+ ServidorPublico(id : Long, nome : String, email : String, telefone : String, dataCadastro : LocalDateTime, matricula : String, cargo : String, orgao : Orgao)<br align="left"/>+ getCargo() : String<br align="left"/>+ getDescricaoPerfil() : String<br align="left"/>+ getMatricula() : String<br align="left"/>+ getOrgao() : Orgao<br align="left"/>+ getTipo() : TipoUsuario<br align="left"/>+ podeAtender(ocorrencia : Ocorrencia) : boolean<br align="left"/>+ podeEditar(ocorrencia : Ocorrencia) : boolean<br align="left"/>+ setCargo(cargo : String) : void<br align="left"/>+ setMatricula(matricula : String) : void<br align="left"/>+ setOrgao(orgao : Orgao) : void<br align="left"/></td></tr></table>>];
    "StatusOcorrencia" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e3f1ec"><font point-size="9">«enumeration»</font><br/><b>StatusOcorrencia</b></td></tr><hr/><tr><td align="left" balign="left">ABERTA<br align="left"/>EM_ANALISE<br align="left"/>EM_ANDAMENTO<br align="left"/>RESOLVIDA<br align="left"/>CANCELADA<br align="left"/>- descricao : String<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ getDescricao() : String<br align="left"/>+ isFinal() : boolean<br align="left"/>+ isPendente() : boolean<br align="left"/>+ podeMudarPara(novo : StatusOcorrencia) : boolean<br align="left"/>+ proximosPermitidos() : Set&lt;StatusOcorrencia&gt;<br align="left"/></td></tr></table>>];
    "TipoUsuario" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e3f1ec"><font point-size="9">«enumeration»</font><br/><b>TipoUsuario</b></td></tr><hr/><tr><td align="left" balign="left">CIDADAO<br align="left"/>SERVIDOR<br align="left"/></td></tr><hr/><tr><td> </td></tr></table>>];
    "Usuario" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e3f1ec"><font point-size="9">«abstract»</font><br/><b><i>Usuario</i></b></td></tr><hr/><tr><td align="left" balign="left">- id : Long<br align="left"/>- nome : String<br align="left"/>- email : String<br align="left"/>- telefone : String<br align="left"/>- dataCadastro : LocalDateTime<br align="left"/></td></tr><hr/><tr><td align="left" balign="left"># Usuario()<br align="left"/># Usuario(id : Long, nome : String, email : String, telefone : String, dataCadastro : LocalDateTime)<br align="left"/>+ getDataCadastro() : LocalDateTime<br align="left"/><i>+ getDescricaoPerfil() : String</i><br align="left"/>+ getEmail() : String<br align="left"/>+ getId() : Long<br align="left"/>+ getNome() : String<br align="left"/>+ getTelefone() : String<br align="left"/><i>+ getTipo() : TipoUsuario</i><br align="left"/><i>+ podeAtender(ocorrencia : Ocorrencia) : boolean</i><br align="left"/><i>+ podeEditar(ocorrencia : Ocorrencia) : boolean</i><br align="left"/>+ setDataCadastro(dataCadastro : LocalDateTime) : void<br align="left"/>+ setEmail(email : String) : void<br align="left"/>+ setId(id : Long) : void<br align="left"/>+ setNome(nome : String) : void<br align="left"/>+ setTelefone(telefone : String) : void<br align="left"/></td></tr></table>>];
    "Zona" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e3f1ec"><font point-size="9">«enumeration»</font><br/><b>Zona</b></td></tr><hr/><tr><td align="left" balign="left">CENTRO<br align="left"/>NORTE<br align="left"/>SUL<br align="left"/>LESTE<br align="left"/>OESTE<br align="left"/></td></tr><hr/><tr><td> </td></tr></table>>];
    "Apoio" -> "Cidadao" [style=invis, weight=10];
    "Atualizacao" -> "NivelPrioridade" [style=invis, weight=10];
    "Bairro" -> "Ocorrencia" [style=invis, weight=10];
    "Categoria" -> "Orgao" [style=invis, weight=10];
    "Cidadao" -> "Priorizavel" [style=invis, weight=10];
    "NivelPrioridade" -> "ServidorPublico" [style=invis, weight=10];
    "Ocorrencia" -> "StatusOcorrencia" [style=invis, weight=10];
    "Orgao" -> "TipoUsuario" [style=invis, weight=10];
    "Priorizavel" -> "Usuario" [style=invis, weight=10];
    "ServidorPublico" -> "Zona" [style=invis, weight=10];
  }
  "Apoio" -> "Cidadao" [arrowhead=vee, headlabel="1", color="#45524d"];
  "Atualizacao" -> "ServidorPublico" [arrowhead=vee, headlabel="1", color="#45524d"];
  "Atualizacao" -> "StatusOcorrencia" [arrowhead=vee, style=dotted, color="#8a96a0"];
  "Bairro" -> "Zona" [arrowhead=vee, style=dotted, color="#8a96a0"];
  "Categoria" -> "Orgao" [arrowhead=vee, headlabel="1", color="#45524d"];
  "Cidadao" -> "Usuario" [arrowhead=empty, color="#0f5c4a", penwidth=1.4];
  "Cidadao" -> "Bairro" [arrowhead=vee, headlabel="1", color="#45524d"];
  "Ocorrencia" -> "Priorizavel" [arrowhead=empty, style=dashed, color="#0f5c4a"];
  "Ocorrencia" -> "Bairro" [arrowhead=vee, headlabel="1", color="#45524d"];
  "Ocorrencia" -> "Categoria" [arrowhead=vee, headlabel="1", color="#45524d"];
  "Ocorrencia" -> "Cidadao" [arrowhead=vee, headlabel="1", color="#45524d"];
  "Ocorrencia" -> "StatusOcorrencia" [arrowhead=vee, style=dotted, color="#8a96a0"];
  "ServidorPublico" -> "Usuario" [arrowhead=empty, color="#0f5c4a", penwidth=1.4];
  "ServidorPublico" -> "Orgao" [arrowhead=vee, headlabel="1", color="#45524d"];
}
