    "ServidorService" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#fdf1de"><b>ServidorService</b></td></tr><hr/><tr><td align="left" balign="left">- dao : ServidorDAO<br align="left"/>- orgaoDAO : OrgaoDAO<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ ServidorService(dao : ServidorDAO, orgaoDAO : OrgaoDAO)<br align="left"/>+ atualizar(id : long, req : ServidorRequest) : ServidorPublico<br align="left"/>+ buscar(id : long) : ServidorPublico<br align="left"/>+ cadastrar(req : ServidorRequest) : ServidorPublico<br align="left"/>+ excluir(id : long, quemExclui : ServidorPublico) : void<br align="left"/>+ listar() : List&lt;ServidorPublico&gt;<br align="left"/>- montar(req : ServidorRequest) : ServidorPublico<br align="left"/></td></tr></table>>];
