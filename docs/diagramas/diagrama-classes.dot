    "CidadaoResource" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#f0e8fa"><b>CidadaoResource</b></td></tr><hr/><tr><td align="left" balign="left">- service : CidadaoService<br align="left"/>- sessoes : SessaoService<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ CidadaoResource(service : CidadaoService, sessoes : SessaoService)<br align="left"/>+ atualizar(perfil : String, u : String, id : long, req : CidadaoRequest) : Cidadao<br align="left"/>+ buscar(perfil : String, u : String, id : long) : Cidadao<br align="left"/>+ cadastrar(req : CidadaoRequest) : Response<br align="left"/>+ excluir(perfil : String, u : String, id : long) : Response<br align="left"/>- exigirProprioCadastro(sessao : Sessao, id : long, acao : String) : void<br align="left"/>+ listar(perfil : String, u : String) : List&lt;Cidadao&gt;<br align="left"/></td></tr></table>>];
