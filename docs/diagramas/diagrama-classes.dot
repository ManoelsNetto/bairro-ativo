digraph UML {
  graph [label="Bairro Ativo - Diagrama de classes (completo)", labelloc=t, fontsize=22, fontname="Helvetica", rankdir=TB, nodesep=0.35, ranksep=0.7, newrank=true];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  subgraph "cluster_(raiz)" {
    label="pacote (raiz)"; style="rounded,dashed"; color="#9aa5a0"; fontsize=13;
    "Main" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#ffffff"><b>Main</b></td></tr><hr/><tr><td align="left" balign="left"><u>- log : Logger</u><br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ Main()<br align="left"/><u>~ configurar(conexoes : ConnectionFactory) : ResourceConfig</u><br align="left"/><u>+ main(args : String[]) : void</u><br align="left"/></td></tr></table>>];
  }
  subgraph "cluster_config" {
    label="pacote config"; style="rounded,dashed"; color="#9aa5a0"; fontsize=13;
    "Config" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#ffffff"><b>Config</b></td></tr><hr/><tr><td align="left" balign="left"><u>- ARQUIVO_ENV : Properties</u><br align="left"/></td></tr><hr/><tr><td align="left" balign="left"><u>- carregarEnv(arquivo : Path) : Properties</u><br align="left"/><u>+ get(chave : String, padrao : String) : String</u><br align="left"/><u>+ obrigatoria(chave : String) : String</u><br align="left"/></td></tr></table>>];
    "ConnectionFactory" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#ffffff"><b>ConnectionFactory</b></td></tr><hr/><tr><td align="left" balign="left">- url : String<br align="left"/>- usuario : String<br align="left"/>- senha : String<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ ConnectionFactory()<br align="left"/>+ getConnection() : Connection<br align="left"/></td></tr></table>>];
    "ErroHandler" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#ffffff"><b>ErroHandler</b></td></tr><hr/><tr><td align="left" balign="left"><u>- log : Logger</u><br align="left"/>- uriInfo : UriInfo<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ ErroHandler()<br align="left"/>- erro(status : int, mensagem : String) : Response<br align="left"/>+ toResponse(e : Throwable) : Response<br align="left"/></td></tr></table>>];
    "JacksonConfig" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#ffffff"><b>JacksonConfig</b></td></tr><hr/><tr><td align="left" balign="left">- mapper : ObjectMapper<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ JacksonConfig()<br align="left"/>+ getContext(type : Class&lt;?&gt;) : ObjectMapper<br align="left"/></td></tr></table>>];
  }
  subgraph "cluster_dao" {
    label="pacote dao"; style="rounded,dashed"; color="#9aa5a0"; fontsize=13;
    "ApoioDAO" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e5edff"><b>ApoioDAO</b></td></tr><hr/><tr><td align="left" balign="left">- conexoes : ConnectionFactory<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ ApoioDAO(conexoes : ConnectionFactory)<br align="left"/>+ excluir(idCidadao : long, idOcorrencia : long) : boolean<br align="left"/>+ inserir(idCidadao : long, idOcorrencia : long) : void<br align="left"/>+ listarPorOcorrencia(idOcorrencia : long) : List&lt;Apoio&gt;<br align="left"/></td></tr></table>>];
    "AtualizacaoDAO" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e5edff"><b>AtualizacaoDAO</b></td></tr><hr/><tr><td align="left" balign="left">- conexoes : ConnectionFactory<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ AtualizacaoDAO(conexoes : ConnectionFactory)<br align="left"/>+ listarPorOcorrencia(idOcorrencia : long) : List&lt;Atualizacao&gt;<br align="left"/>+ registrar(atualizacao : Atualizacao, dataResolucao : LocalDateTime) : Atualizacao<br align="left"/></td></tr></table>>];
    "BairroDAO" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e5edff"><b>BairroDAO</b></td></tr><hr/><tr><td align="left" balign="left"><u>- SELECT : String</u><br align="left"/>- conexoes : ConnectionFactory<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ BairroDAO(conexoes : ConnectionFactory)<br align="left"/>+ atualizar(bairro : Bairro) : boolean<br align="left"/>+ buscarPorId(id : long) : Optional&lt;Bairro&gt;<br align="left"/>+ excluir(id : long) : boolean<br align="left"/>+ inserir(bairro : Bairro) : Bairro<br align="left"/>+ listar() : List&lt;Bairro&gt;<br align="left"/>- mapear(rs : ResultSet) : Bairro<br align="left"/></td></tr></table>>];
    "CategoriaDAO" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e5edff"><b>CategoriaDAO</b></td></tr><hr/><tr><td align="left" balign="left"><u>- SELECT : String</u><br align="left"/>- conexoes : ConnectionFactory<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ CategoriaDAO(conexoes : ConnectionFactory)<br align="left"/>+ atualizar(categoria : Categoria) : boolean<br align="left"/>+ buscarPorId(id : long) : Optional&lt;Categoria&gt;<br align="left"/>+ excluir(id : long) : boolean<br align="left"/>+ inserir(categoria : Categoria) : Categoria<br align="left"/>+ listar() : List&lt;Categoria&gt;<br align="left"/>- mapear(rs : ResultSet) : Categoria<br align="left"/></td></tr></table>>];
    "CidadaoDAO" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e5edff"><b>CidadaoDAO</b></td></tr><hr/><tr><td align="left" balign="left"><u>- SELECT : String</u><br align="left"/>- conexoes : ConnectionFactory<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ CidadaoDAO(conexoes : ConnectionFactory)<br align="left"/>+ atualizar(cidadao : Cidadao) : boolean<br align="left"/>+ buscarPorEmail(email : String) : Optional&lt;Cidadao&gt;<br align="left"/>+ buscarPorId(id : long) : Optional&lt;Cidadao&gt;<br align="left"/>- buscarUm(sql : String, parametro : Object) : Optional&lt;Cidadao&gt;<br align="left"/>+ excluir(id : long) : boolean<br align="left"/>+ inserir(cidadao : Cidadao) : Cidadao<br align="left"/>+ listar() : List&lt;Cidadao&gt;<br align="left"/>- mapear(rs : ResultSet) : Cidadao<br align="left"/></td></tr></table>>];
    "CrudDAO" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e5edff"><font point-size="9">«interface»</font><br/><b>CrudDAO</b></td></tr><hr/><tr><td> </td></tr><hr/><tr><td align="left" balign="left">+ atualizar(entidade : T) : boolean<br align="left"/>+ buscarPorId(id : long) : Optional&lt;T&gt;<br align="left"/>+ excluir(id : long) : boolean<br align="left"/>+ inserir(entidade : T) : T<br align="left"/>+ listar() : List&lt;T&gt;<br align="left"/></td></tr></table>>];
    "JdbcUtil" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e5edff"><b>JdbcUtil</b></td></tr><hr/><tr><td> </td></tr><hr/><tr><td align="left" balign="left"><u>~ dataHora(rs : ResultSet, coluna : String) : LocalDateTime</u><br align="left"/><u>~ doubleOuNull(rs : ResultSet, coluna : String) : Double</u><br align="left"/><u>~ idGerado(ps : PreparedStatement) : long</u><br align="left"/><u>~ longOuNull(rs : ResultSet, coluna : String) : Long</u><br align="left"/><u>~ setDataHora(ps : PreparedStatement, indice : int, valor : LocalDateTime) : void</u><br align="left"/><u>~ setLong(ps : PreparedStatement, indice : int, valor : Long) : void</u><br align="left"/></td></tr></table>>];
    "OcorrenciaDAO" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e5edff"><b>OcorrenciaDAO</b></td></tr><hr/><tr><td align="left" balign="left"><u>- SELECT : String</u><br align="left"/>- conexoes : ConnectionFactory<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ OcorrenciaDAO(conexoes : ConnectionFactory)<br align="left"/>+ atualizar(ocorrencia : Ocorrencia) : boolean<br align="left"/>+ buscarPorId(id : long) : Optional&lt;Ocorrencia&gt;<br align="left"/>+ excluir(id : long) : boolean<br align="left"/>+ inserir(ocorrencia : Ocorrencia) : Ocorrencia<br align="left"/>+ listar() : List&lt;Ocorrencia&gt;<br align="left"/>+ listar(filtro : FiltroOcorrencia) : List&lt;Ocorrencia&gt;<br align="left"/>- mapear(rs : ResultSet) : Ocorrencia<br align="left"/></td></tr></table>>];
    "OrgaoDAO" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e5edff"><b>OrgaoDAO</b></td></tr><hr/><tr><td align="left" balign="left"><u>- SELECT : String</u><br align="left"/>- conexoes : ConnectionFactory<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ OrgaoDAO(conexoes : ConnectionFactory)<br align="left"/>+ atualizar(orgao : Orgao) : boolean<br align="left"/>+ buscarPorId(id : long) : Optional&lt;Orgao&gt;<br align="left"/>+ excluir(id : long) : boolean<br align="left"/>+ inserir(orgao : Orgao) : Orgao<br align="left"/>+ listar() : List&lt;Orgao&gt;<br align="left"/>- mapear(rs : ResultSet) : Orgao<br align="left"/></td></tr></table>>];
    "RelatorioDAO" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e5edff"><b>RelatorioDAO</b></td></tr><hr/><tr><td align="left" balign="left"><u>- PENDENTE : String</u><br align="left"/>- conexoes : ConnectionFactory<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ RelatorioDAO(conexoes : ConnectionFactory)<br align="left"/>+ bancoDisponivel() : boolean<br align="left"/>+ engajamento(limite : int) : List&lt;EngajamentoDTO&gt;<br align="left"/>+ porBairro() : List&lt;RelatorioBairroDTO&gt;<br align="left"/>+ porCategoria() : List&lt;RelatorioCategoriaDTO&gt;<br align="left"/>+ porOrgao() : List&lt;RelatorioOrgaoDTO&gt;<br align="left"/>+ resumo() : ResumoDTO<br align="left"/></td></tr></table>>];
    "ServidorDAO" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e5edff"><b>ServidorDAO</b></td></tr><hr/><tr><td align="left" balign="left"><u>- SELECT : String</u><br align="left"/>- conexoes : ConnectionFactory<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ ServidorDAO(conexoes : ConnectionFactory)<br align="left"/>+ atualizar(servidor : ServidorPublico) : boolean<br align="left"/>+ buscarPorEmail(email : String) : Optional&lt;ServidorPublico&gt;<br align="left"/>+ buscarPorId(id : long) : Optional&lt;ServidorPublico&gt;<br align="left"/>- buscarUm(sql : String, parametro : Object) : Optional&lt;ServidorPublico&gt;<br align="left"/>+ excluir(id : long) : boolean<br align="left"/>+ inserir(servidor : ServidorPublico) : ServidorPublico<br align="left"/>+ listar() : List&lt;ServidorPublico&gt;<br align="left"/>- mapear(rs : ResultSet) : ServidorPublico<br align="left"/>- preencher(ps : PreparedStatement, servidor : ServidorPublico) : void<br align="left"/></td></tr></table>>];
    "ApoioDAO" -> "CidadaoDAO" [style=invis, weight=10];
    "AtualizacaoDAO" -> "CrudDAO" [style=invis, weight=10];
    "BairroDAO" -> "JdbcUtil" [style=invis, weight=10];
    "CategoriaDAO" -> "OcorrenciaDAO" [style=invis, weight=10];
    "CidadaoDAO" -> "OrgaoDAO" [style=invis, weight=10];
    "CrudDAO" -> "RelatorioDAO" [style=invis, weight=10];
    "JdbcUtil" -> "ServidorDAO" [style=invis, weight=10];
  }
  subgraph "cluster_dto" {
    label="pacote dto"; style="rounded,dashed"; color="#9aa5a0"; fontsize=13;
