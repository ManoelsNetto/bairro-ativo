    label="pacote service"; style="rounded,dashed"; color="#9aa5a0"; fontsize=13;
    "BairroService" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#fdf1de"><b>BairroService</b></td></tr><hr/><tr><td align="left" balign="left">- dao : BairroDAO<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ BairroService(dao : BairroDAO)<br align="left"/>+ atualizar(id : long, dados : Bairro) : Bairro<br align="left"/>+ buscar(id : long) : Bairro<br align="left"/>+ criar(dados : Bairro) : Bairro<br align="left"/>+ excluir(id : long) : void<br align="left"/>+ listar() : List&lt;Bairro&gt;<br align="left"/>~ validar(dados : Bairro) : Bairro<br align="left"/></td></tr></table>>];
