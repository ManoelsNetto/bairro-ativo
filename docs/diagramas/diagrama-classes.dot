ucao(dataResolucao : LocalDateTime) : void<br align="left"/>+ setDescricao(descricao : String) : void<br align="left"/>+ setEndereco(endereco : String) : void<br align="left"/>+ setId(id : Long) : void<br align="left"/>+ setReferencia(referencia : String) : void<br align="left"/>+ setStatus(status : StatusOcorrencia) : void<br align="left"/>+ setTitulo(titulo : String) : void<br align="left"/>+ setTotalApoios(totalApoios : int) : void<br align="left"/></td></tr></table>>];
