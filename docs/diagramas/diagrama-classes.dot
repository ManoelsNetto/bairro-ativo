    "CidadaoService" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#fdf1de"><b>CidadaoService</b></td></tr><hr/><tr><td align="left" balign="left">- dao : CidadaoDAO<br align="left"/>- bairroDAO : BairroDAO<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ CidadaoService(dao : CidadaoDAO, bairroDAO : BairroDAO)<br align="left"/>+ atualizar(id : long, req : CidadaoRequest) : Cidadao<br align="left"/>+ buscar(id : long) : Cidadao<br align="left"/>+ cadastrar(req : CidadaoRequest) : Cidadao<br align="left"/>+ excluir(id : long) : void<br align="left"/>+ listar() : List&lt;Cidadao&gt;<br align="left"/>- montar(req : CidadaoRequest) : Cidadao<br align="left"/></td></tr></table>>];
    "OcorrenciaService" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#fdf1de"><b>OcorrenciaService</b></td></tr><hr/><tr><td align="left" balign="left"><u>- POR_PRIORIDADE : Comparator&lt;Ocorrencia&gt;</u><br align="left"/>- dao : OcorrenciaDAO<br align="left"/>- apoioDAO : ApoioDAO<br align="left"/>- atualizacaoDAO : AtualizacaoDAO<br align="left"/>- bairroDAO : BairroDAO<br align="left"/>- categoriaDAO : CategoriaDAO<br align="left"/>- sessoes : SessaoService<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ OcorrenciaService(dao : OcorrenciaDAO, apoioDAO : ApoioDAO, atualizacaoDAO : AtualizacaoDAO, bairroDAO : BairroDAO, categoriaDAO : CategoriaDAO, sessoes : SessaoService)<br align="left"/>+ apoiadas(sessao : Sessao) : List&lt;Ocorrencia&gt;<br align="left"/>+ apoiar(sessao : Sessao, idOcorrencia : long) : Ocorrencia<br align="left"/>+ atualizar(sessao : Sessao, id : long, req : OcorrenciaRequest) : Ocorrencia<br align="left"/>+ atualizarStatus(sessao : Sessao, idOcorrencia : long, req : AtualizacaoRequest) : Atualizacao<br align="left"/>+ buscar(id : long) : Ocorrencia<br align="left"/>+ detalhar(id : long, sessao : Sessao) : OcorrenciaDetalheDTO<br align="left"/>+ excluir(sessao : Sessao, id : long) : void<br align="left"/>- exigirAutor(cidadao : Cidadao, ocorrencia : Ocorrencia, acao : String) : void<br align="left"/>+ fila(sessao : Sessao) : List&lt;Ocorrencia&gt;<br align="left"/>+ listar(filtro : FiltroOcorrencia) : List&lt;Ocorrencia&gt;<br align="left"/>+ minhas(sessao : Sessao) : List&lt;Ocorrencia&gt;<br align="left"/>- montar(req : OcorrenciaRequest) : Ocorrencia<br align="left"/>+ ranking(limite : int) : List&lt;Ocorrencia&gt;<br align="left"/>+ registrar(sessao : Sessao, req : OcorrenciaRequest) : Ocorrencia<br align="left"/>+ removerApoio(sessao : Sessao, idOcorrencia : long) : Ocorrencia<br align="left"/>- validarLimite(limite : int) : void<br align="left"/></td></tr></table>>];
