  subgraph "cluster_exception" {
    label="pacote exception"; style="rounded,dashed"; color="#9aa5a0"; fontsize=13;
    "AppException" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#fde8e6"><font point-size="9">«abstract»</font><br/><b><i>AppException</i></b></td></tr><hr/><tr><td> </td></tr><hr/><tr><td align="left" balign="left"># AppException(mensagem : String)<br align="left"/># AppException(mensagem : String, causa : Throwable)<br align="left"/><i>+ getStatusHttp() : int</i><br align="left"/></td></tr></table>>];
    "DadosException" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#fde8e6"><b>DadosException</b></td></tr><hr/><tr><td align="left" balign="left">- statusHttp : int<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ DadosException(mensagem : String, causa : Throwable, statusHttp : int)<br align="left"/><u>+ de(operacao : String, e : SQLException) : AppException</u><br align="left"/>+ getStatusHttp() : int<br align="left"/><u>- mensagemUnica(mensagemOracle : String) : String</u><br align="left"/><u>- mensagemVinculo(mensagemOracle : String) : String</u><br align="left"/></td></tr></table>>];
    "NaoEncontradoException" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#fde8e6"><b>NaoEncontradoException</b></td></tr><hr/><tr><td> </td></tr><hr/><tr><td align="left" balign="left">+ NaoEncontradoException(mensagem : String)<br align="left"/>+ getStatusHttp() : int<br align="left"/></td></tr></table>>];
    "RegraNegocioException" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#fde8e6"><b>RegraNegocioException</b></td></tr><hr/><tr><td> </td></tr><hr/><tr><td align="left" balign="left">+ RegraNegocioException(mensagem : String)<br align="left"/>+ getStatusHttp() : int<br align="left"/></td></tr></table>>];
    "ValidacaoException" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#fde8e6"><b>ValidacaoException</b></td></tr><hr/><tr><td> </td></tr><hr/><tr><td align="left" balign="left">+ ValidacaoException(mensagem : String)<br align="left"/>+ getStatusHttp() : int<br align="left"/></td></tr></table>>];
    "AppException" -> "ValidacaoException" [style=invis, weight=10];
  }
  subgraph "cluster_model" {
    label="pacote model"; style="rounded,dashed"; color="#9aa5a0"; fontsize=13;
    "AgentePublico" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#e3f1ec"><b>AgentePublico</b></td></tr><hr/><tr><td align="left" balign="left">- orgao : String<br align="left"/>- matricula : String<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ AgentePublico()<br align="left"/>+ AgentePublico(id : Long, nome : String, email : String, telefone : String, dataCadastro : LocalDateTime, orgao : String, matricula : String)<br align="left"/>+ getMatricula() : String<br align="left"/>+ getOrgao() : String<br align="left"/>+ getTipo() : TipoUsuario<br align="left"/>+ podeAtenderOcorrencias() : boolean<br align="left"/>+ podeRegistrarOcorrencias() : boolean<br align="left"/>+ setMatricula(matricula : String) : void<br align="left"/>+ setOrgao(orgao : String) : void<br align="left"/></td></tr></table>>];
