    "OcorrenciaResource" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#f0e8fa"><b>OcorrenciaResource</b></td></tr><hr/><tr><td align="left" balign="left">- service : OcorrenciaService<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ OcorrenciaResource(service : OcorrenciaService)<br align="left"/>+ apoiadas(perfil : String, u : String) : List&lt;Ocorrencia&gt;<br align="left"/>+ apoiar(perfil : String, u : String, id : long) : Response<br align="left"/>+ atualizar(perfil : String, u : String, id : long, req : OcorrenciaRequest) : Ocorrencia<br align="left"/>+ atualizarStatus(perfil : String, u : String, id : long, req : AtualizacaoRequest) : Response<br align="left"/>+ detalhar(perfil : String, u : String, id : long) : OcorrenciaDetalheDTO<br align="left"/>+ excluir(perfil : String, u : String, id : long) : Response<br align="left"/>+ fila(perfil : String, u : String) : List&lt;Ocorrencia&gt;<br align="left"/>+ listar(status : String, bairro : Long, categoria : Long, texto : String) : List&lt;Ocorrencia&gt;<br align="left"/>+ minhas(perfil : String, u : String) : List&lt;Ocorrencia&gt;<br align="left"/>+ ranking(limite : int) : List&lt;Ocorrencia&gt;<br align="left"/>+ registrar(perfil : String, u : String, req : OcorrenciaRequest) : Response<br align="left"/>+ removerApoio(perfil : String, u : String, id : long) : Ocorrencia<br align="left"/></td></tr></table>>];
    "OrgaoResource" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#f0e8fa"><b>OrgaoResource</b></td></tr><hr/><tr><td align="left" balign="left"><u>- GESTAO : String</u><br align="left"/>- service : OrgaoService<br align="left"/>- sessoes : SessaoService<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ OrgaoResource(service : OrgaoService, sessoes : SessaoService)<br align="left"/>+ atualizar(perfil : String, u : String, id : long, orgao : Orgao) : Orgao<br align="left"/>+ buscar(id : long) : Orgao<br align="left"/>+ criar(perfil : String, u : String, orgao : Orgao) : Response<br align="left"/>+ excluir(perfil : String, u : String, id : long) : Response<br align="left"/>+ listar() : List&lt;Orgao&gt;<br align="left"/></td></tr></table>>];
    "RelatorioResource" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white" color="#45524d"><tr><td bgcolor="#f0e8fa"><b>RelatorioResource</b></td></tr><hr/><tr><td align="left" balign="left">- service : RelatorioService<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+ RelatorioResource(service : RelatorioService)<br align="left"/>+ engajamento(limite : int) : List&lt;EngajamentoDTO&gt;<br align="left"/>+ porBairro() : List&lt;RelatorioBairroDTO&gt;<br align="left"/>+ porCategoria() : List&lt;RelatorioCategoriaDTO&gt;<br align="left"/>+ porOrgao() : List&lt;RelatorioOrgaoDTO&gt;<br align="left"/>+ resumo() : ResumoDTO<br align="left"/>+ status() : Response<br align="left"/></td></tr></table>>];
